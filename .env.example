# ORBIT AI configuration (copy to .env; never commit .env)
#
# Every setting is read from the process environment with the ORBIT_ prefix.
# Values shown below are the safe defaults; uncomment only what you need.

# Runtime
ORBIT_ENV=development
ORBIT_HOST=127.0.0.1
ORBIT_PORT=18700
ORBIT_LOG_LEVEL=INFO
# ORBIT_LOG_JSON=false
# ORBIT_DOCS_ENABLED=true

# Storage (must be writable by the user running ORBIT AI)
# ORBIT_DATA_DIR=/var/lib/orbit-ai
# ORBIT_LOG_DIR=/var/log/orbit-ai
# ORBIT_DATABASE_URL=sqlite+aiosqlite:////var/lib/orbit-ai/orbit.db
# ORBIT_AUTO_MIGRATE=true

# Browser origins allowed to call the API (JSON list or comma-separated)
# ORBIT_CORS_ORIGINS=http://127.0.0.1:5173

# Providers (leave empty until configured through the setup wizard)
# ORBIT_OPENROUTER_API_KEY=
# ORBIT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ORBIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# ORBIT_REQUEST_TIMEOUT_SECONDS=120
# ORBIT_PROVIDER_MAX_ATTEMPTS=3
# ORBIT_PROVIDER_RETRY_BACKOFF_SECONDS=0.5
# ORBIT_GENERATION_TIMEOUT_SECONDS=300
# Maximum assistant output tokens allowed by ORBIT AI
# ORBIT_MAX_OUTPUT_TOKENS=8192
